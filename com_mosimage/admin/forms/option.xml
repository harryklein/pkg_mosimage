<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="HKlein\Component\Mosimage\Administrator\Field">
	<fieldset name="mosimage">
		<!-- Eigenschaften des ausgewählten Bildes -->
		<field name="_source" type="text" readonly="true"
			label="COM_MOSIMAGE_SOURCE" description="COM_MOSIMAGE_SOURCE_DESC"/>

		<field name="accesslevel" type="accesslevel"
			label="JFIELD_ACCESS_LABEL"/>

		<field name="_align" type="list" default="left"
			label="COM_MOSIMAGE_IMAGE_ALIGN" description="COM_MOSIMAGE_IMAGE_ALIGN_DESC">
			<option value="">JNONE</option>
			<option value="left">JGLOBAL_LEFT</option>
			<option value="right">JGLOBAL_RIGHT</option>
			<option value="center">JGLOBAL_CENTER</option>
		</field>

		<field name="_alt" type="text"
			label="COM_MOSIMAGE_ALT_TEXT" description="COM_MOSIMAGE_ALT_TEXT_DESC"/>

		<field name="_border" type="list" default="0"
			label="COM_MOSIMAGE_BORDER" description="COM_MOSIMAGE_BORDER_DESC">
			<option value="0">COM_MOSIMAGE_DEFAULT</option>
			<option value="hidden">COM_MOSIMAGE_HIDDEN</option>
			<option value="1">1</option>
			<option value="2">2</option>
			<option value="3">3</option>
		</field>

		<field name="_caption" type="text"
			label="COM_MOSIMAGE_CAPTION" description="COM_MOSIMAGE_CAPTION_DESC"/>

		<field name="_caption_position" type="list" default=""
			label="COM_MOSIMAGE_CAPTION_POSITION" description="COM_MOSIMAGE_CAPTION_POSITION_DESC">
			<option value="">COM_MOSIMAGE_DEFAULT</option>
			<option value="bottom">COM_MOSIMAGE_BOTTOM</option>
			<option value="top">COM_MOSIMAGE_TOP</option>
			<option value="hide">COM_MOSIMAGE_HIDDEN</option>
		</field>

		<!-- Vorschau -->
		<field name="view_imagefiles" type="mosimagepreview" class="mosimage-preview"
			alt="COM_MOSIMAGE_PREVIEW" label="COM_MOSIMAGE_PREVIEW_LABEL" description="COM_MOSIMAGE_PREVIEW_DESC"/>
		<field name="view_imagelist" type="mosimagepreview" class="mosimage-preview"
			alt="COM_MOSIMAGE_ACTIVE_IMAGE" label="COM_MOSIMAGE_ACTIVE_IMAGE_LABEL" description="COM_MOSIMAGE_ACTIVE_IMAGE_DESC"/>

		<!-- Liste aller Ordner unter /images -->
		<field name="folder" type="folderlistrecursive" directory="images"
			label="COM_MOSIMAGE_SUBFOLDER"/>

		<!-- Inhalt der Liste wird per JS befüllt -->
		<field name="imagefiles" type="list" size="10" multiple="true"
			label="COM_MOSIMAGE_GALLERY_IMAGES" description="COM_MOSIMAGE_GALLERY_IMAGES_DESC"/>

		<!-- Liste der Bilder, die einem Beitrag zugeordnet sind -->
		<field name="imageslist" type="mosimagelist" size="10" multiple="true"
			label="COM_MOSIMAGE_CONTENT_IMAGES" description="COM_MOSIMAGE_CONTENT_IMAGES_DESC"/>

		<field name="add" type="mosimagebutton" label="COM_MOSIMAGE_ADD_BUTTON_LABEL" description="COM_MOSIMAGE_ADD_BUTTON_LABEL_DESC"
			class="btn btn-secondary" icon="icon-arrow-right"/>
		<field name="remove" type="mosimagebutton" label="COM_MOSIMAGE_REMOVE_BUTTON_LABEL" description="COM_MOSIMAGE_REMOVE_BUTTON_LABEL_DESC"
			class="btn btn-secondary" icon="icon-arrow-left"/>

		<field name="pos1" type="mosimagebutton" label="COM_MOSIMAGE_POS1_LABEL" description="COM_MOSIMAGE_POS1_LABEL_DESC"
			class="btn btn-outline-secondary btn-sm" icon="icon-arrow-up-4"/>
		<field name="up" type="mosimagebutton" label="COM_MOSIMAGE_UP_LABEL" description="COM_MOSIMAGE_UP_LABEL_DESC"
			class="btn btn-outline-secondary btn-sm" icon="icon-arrow-up"/>
		<field name="down" type="mosimagebutton" label="COM_MOSIMAGE_DOWN_LABEL" description="COM_MOSIMAGE_DOWN_LABEL_DESC"
			class="btn btn-outline-secondary btn-sm" icon="icon-arrow-down"/>
		<field name="end" type="mosimagebutton" label="COM_MOSIMAGE_END_LABEL" description="COM_MOSIMAGE_END_LABEL_DESC"
			class="btn btn-outline-secondary btn-sm" icon="icon-arrow-down-4"/>

		<field name="applay" type="mosimagebutton" class="btn btn-primary" label="COM_MOSIMAGE_APPLY"/>
		<field name="reset" type="mosimagebutton" class="btn btn-secondary" label="COM_MOSIMAGE_RESET_BUTTON"/>

		<field name="content_id" type="hidden" filter="integer"/>
		<field name="images" type="hidden"/>
	</fieldset>
</form>
