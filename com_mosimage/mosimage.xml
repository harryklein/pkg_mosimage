<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
	<name>com_mosimage</name>
	<creationDate>DATE</creationDate>
	<author>Harry Klein</author>
	<authorEmail>harry.klein@joomla-hklein.de</authorEmail>
	<authorUrl>http://www.joomla-hklein.de</authorUrl>
	<copyright>(C) 2009-2026 Harry Klein. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>HEAD</version>
	<description>COM_MOSIMAGE_DESC</description>
	<namespace path="src">HKlein\Component\Mosimage</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<files folder="site">
		<folder>src</folder>
	</files>

	<media destination="com_mosimage" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<administration>
		<menu link="option=com_mosimage&amp;view=info">COM_MOSIMAGE</menu>
		<files folder="admin">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="admin/language">
			<language tag="de-DE">de-DE/com_mosimage.ini</language>
			<language tag="de-DE">de-DE/com_mosimage.sys.ini</language>
			<language tag="en-GB">en-GB/com_mosimage.ini</language>
			<language tag="en-GB">en-GB/com_mosimage.sys.ini</language>
		</languages>
	</administration>
</extension>
